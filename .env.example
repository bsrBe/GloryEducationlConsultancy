# Server Configuration
PORT=3000

# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/glory-admissions

# JWT Authentication & Room Token Security
JWT_SECRET=change-this-to-a-strong-random-secret-key
JWT_EXPIRY=7d

# Cloudinary (Student PDF & Academic Documents)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Brevo (Transactional Emails)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=admissions@gloryedu.com
BREVO_SENDER_NAME="Glory Educational Consultancy"

# links.et Payment Gateway Verification
LINKS_ET_API_KEY=vk_live_your_actual_key_from_links_et
PAYMENT_EXPECTED_AMOUNT=500
PAYMENT_RECEIVER_NAME="Glory Educational Consultancy"

# Whereby (Video Conferencing — 2,000 free participant-minutes/month)
# Get your API key at https://whereby.com → Embedded dashboard → Configure
WHEREBY_API_KEY=your_whereby_api_key
